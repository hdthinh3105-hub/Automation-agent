# ==============================================
# Docker Compose — ENV
# ==============================================
# Copy file này thành .env rồi điền giá trị thực.
# KHÔNG commit .env lên git.

# ---- JWT (bắt buộc) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- LLM ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Embedding ----
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# ---- RAG ----
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RAG_TOP_K_RETRIEVAL=25
RAG_TOP_K_FINAL=8
RAG_EMBEDDING_BATCH_SIZE=16

# ---- AI Thresholds ----
AI_CONFIDENCE_ESCALATION_THRESHOLD=0.6
SPAM_SCORE_THRESHOLD=0.8

# ---- Telegram (tùy chọn) ----
TELEGRAM_BOT_TOKEN=
# true = long-poll getUpdates (local, không cần URL); false = webhook (phải có URL public như Render)
TELEGRAM_POLLING_ENABLED=false

# ---- Gmail (tùy chọn, SMTP fallback) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_POLLING_ENABLED=false

# ---- SMTP (tùy chọn) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@example.com

# ---- Notification ----
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# ---- Storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
